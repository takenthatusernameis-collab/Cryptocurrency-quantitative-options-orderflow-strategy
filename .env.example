# Environment variables for crypto options orderflow strategy
# Copy to .env and fill in your credentials (NEVER commit .env)

# Venue credentials
DERIBIT_API_KEY=
DERIBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trading mode
TRADING_MODE=paper  # paper or live
LIVE_TRADING_ENABLED=false

# Risk limits
MAX_DAILY_LOSS=50000
MAX_POSITION_NOTIONAL=1000000
MAX_DRAWDOWN_PCT=0.15

# Secrets handling
SECRETS_PROVIDER=env  # env or vault
