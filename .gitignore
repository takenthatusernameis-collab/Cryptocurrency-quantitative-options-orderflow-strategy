__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/
data/*.csv
data/*.parquet
data/*.json
*.log

# Real public OKX exports are reproducible via EVAL-26 (src/data/public_export_acquisition.py)
# and are large; keep them out of the checkout. Synthetic fixtures remain tracked.
data/raw/orderflow_okx_*.json
data/raw/options_okx_*.json
!data/raw/eval45/
!data/raw/eval45/orderflow_okx_*.json
# EVAL-48 real Deribit option snapshots are reproducible via
# scripts/eval48_acquire_deribit_options.py and are durable inputs; keep them tracked.
!data/raw/eval48/
!data/raw/eval48/options_deribit_*.json
# EVAL-49 real Deribit ETH option snapshots (same acquisition script, --underlying ETH)
# are durable inputs; keep them tracked so a reset does not wipe them.
!data/raw/eval49/
!data/raw/eval49/options_deribit_*.json
# EVAL-50 real OKX L2 order-book depth snapshots are reproducible via
# scripts/eval50_acquire_l2_depth.py (live polling; no historical REST endpoint).
# They are durable inputs; keep them tracked so a reset does not wipe them.
!data/raw/eval50/
!data/raw/eval50/l2_depth_*.json

# EVAL-63/EVAL-65 real 7d Deribit three-way captures (~170 MB each) exceed
# GitHub's 100 MB per-file push limit; keep them on local disk only and never
# commit or push them. Re-acquire locally for EVAL-65 via the capture step.
data/raw/eval63/

# EVAL-66 fresh real 7d ETH capture (~170 MB) has the same per-file push limit;
# keep it local only and never commit or push it.
data/raw/eval66/

research_state/INTEGRATED_CAMPAIGN_*.json
research_state/INTEGRATED_STEP_*.json

# Machine-generated phaseNN_* evidence trees: 188 dirs / 48,309 files / ~5.0 GB,
# each holding dozens of near-identical timestamped reports. Already committed
# historically; stop adding more so the checkout and every checkpoint stay cheap.
research_state/phase*/

# Local verification runtime (scripts/verify_env.sh target)
.venv-deps/
